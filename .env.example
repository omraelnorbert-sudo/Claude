# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Schlüssel: umgeht alle Zugriffsregeln.
# Wird gebraucht, um Nutzerkonten anzulegen und zu löschen.
# Niemals mit NEXT_PUBLIC_ beginnen lassen und nie ins Repository committen.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — für den E-Mail-Versand (kommt in der letzten Projektphase)
RESEND_API_KEY=

# Wer ins Dashboard darf. Mehrere Adressen mit Komma trennen.
# Maßgeblich ist die Tabelle `admins` in Supabase; dieser Wert ist die
# Rückfallebene, solange das Schema noch nicht eingespielt ist.
ADMIN_EMAILS=omraelnorbert@gmail.com
